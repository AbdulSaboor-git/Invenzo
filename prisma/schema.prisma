enum Role {
  admin
  cashier
  superadmin
}

enum Unit {
  kg
  g
  litre
  ml
  pc
  dozen
  box
  pack
}

enum PayMode {
  cash
  credit
  card
  upi
  other
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model User {
  id             Int        @id @default(autoincrement())
  email          String     @unique
  password       String
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  firstName      String
  lastName       String?
  lastLogin      DateTime?
  profilePicture String?
  isActive       Boolean    @default(true)
  role           Role?
  Cashier        Cashier?
  Inventories    Inventory?
}

model Inventory {
  id             Int        @id @default(autoincrement())
  name           String
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  profilePicture String?
  adminId        Int        @unique(map: "inventory_admin_unique")
  Cashier        Cashier[]
  categories     Category[]
  admin          User       @relation(fields: [adminId], references: [id])
  products       Product[]
  Sale           Sale[]
}

model Product {
  id            Int        @id @default(autoincrement())
  name          String
  description   String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  categoryId    Int
  inventoryId   Int
  govtSalePrice Float?
  purchasePrice Float
  salePrice     Float
  tags          String?
  unit          Unit?
  category      Category   @relation(fields: [categoryId], references: [id])
  inventory     Inventory  @relation(fields: [inventoryId], references: [id])
  SaleItem      SaleItem[]
}

model Category {
  id          Int       @id @default(autoincrement())
  name        String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  inventoryId Int
  inventory   Inventory @relation(fields: [inventoryId], references: [id])
  products    Product[]

  @@unique([name, inventoryId])
}

model Cashier {
  id          Int       @id(map: "Moderator_pkey") @default(autoincrement())
  userId      Int       @unique(map: "cashier_user_unique")
  inventoryId Int
  Inventory   Inventory @relation(fields: [inventoryId], references: [id], map: "Moderator_inventoryId_fkey")
  User        User      @relation(fields: [userId], references: [id], map: "Moderator_userId_fkey")
  Sale        Sale[]
}

model Sale {
  id          Int        @id @default(autoincrement())
  createdAt   DateTime   @default(now()) @db.Timestamp(6)
  totalAmount Float
  cashierId   Int
  inventoryId Int
  discount    Float      @default(0)
  tax         Float      @default(0)
  paidAmount  Float?
  paymentMode PayMode    @default(cash)
  note        String?
  deactivated Boolean    @default(false)
  Cashier     Cashier    @relation(fields: [cashierId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_cashier")
  Inventory   Inventory  @relation(fields: [inventoryId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_inventory")
  SaleItem    SaleItem[]
}

model SaleItem {
  id            Int     @id @default(autoincrement())
  saleId        Int
  productId     Int
  quantity      Float
  price         Float
  purchasePrice Float? // snapshot of product.purchasePrice at time of sale (ARCH-04)
  Product       Product @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_product")
  Sale          Sale    @relation(fields: [saleId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_sale")
}
